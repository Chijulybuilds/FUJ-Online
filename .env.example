# Copy this file to .env.local and fill in the values.
# With no Supabase service-role key the app stores data in a local JSON file (.data/) with demo data.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FlagUpJesus
NEXT_PUBLIC_CHURCH_NAME=Flag of Jesus Global Ministry

# Supabase (database). The server uses the service-role key; it is never sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in (OAuth client from Google Cloud Console → APIs & Services → Credentials).
# Authorised redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
CLIENT_ID=
CLIENT_SECRET=

# Shared FUJ admin login used at /admin/login (one email + password every FUJ admin can use).
# Use a long, unique password and change it when someone leaves the team.
ADMIN_LOGIN_EMAIL=admin@flagupjesus.org
ADMIN_LOGIN_PASSWORD=
# Role for the shared login: super_admin | admin | pastor | pastoral_worker | finance_admin | department_leader
ADMIN_LOGIN_ROLE=super_admin

# Optional: individual staff can also sign in with Google. These Google emails become super admins on first sign-in.
ADMIN_EMAILS=

# HMAC secret for sessions, QR tokens and check-in tickets (32+ random chars, server-only).
# Generate one with: openssl rand -base64 48
QR_SIGNING_SECRET=replace-with-at-least-32-random-bytes

# SMS (Termii) — sends registration OTP codes and SMS broadcasts / WhatsApp fallback.
TERMII_API_KEY=
TERMII_SENDER_ID=
# "generic" or "dnd" (dnd reaches Nigerian numbers on Do-Not-Disturb; needs activation on Termii)
TERMII_CHANNEL=generic

# WhatsApp Business Cloud API (Meta) — broadcasts go to WhatsApp first, SMS for numbers not on WhatsApp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved message template with two body variables: {{1}} = title, {{2}} = message.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# Webhook: callback URL <APP_URL>/api/webhooks/whatsapp, subscribe to "messages".
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Email (Resend) — optional

RESEND_API_KEY=
EMAIL_FROM=

# Developer sign-in without Google (unverified!). Auto-on only for local dev with the local JSON store.
# ALLOW_DEV_LOGIN=false
