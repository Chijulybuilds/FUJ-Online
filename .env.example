# Copy this file to .env.local and fill in the values.
# With no Supabase service-role key the app stores data in a local JSON file (.data/). It starts empty.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FlagUpJesus
NEXT_PUBLIC_CHURCH_NAME=FlagUpJesus Global Ministry

# Supabase (database). The server uses the service-role key; it is never sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in (OAuth client from Google Cloud Console → APIs & Services → Credentials).
# Authorised redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
CLIENT_ID=
CLIENT_SECRET=

# Shared FUJ admin login used at /admin/login (one email + password every FUJ admin can use).
# Use a long, unique password and change it when someone leaves the team.
ADMIN_LOGIN_EMAIL=admin@flagupjesus.org
ADMIN_LOGIN_PASSWORD=
# Role for the shared login: super_admin | admin | pastor | pastoral_worker | finance_admin | department_leader (= Usher)
ADMIN_LOGIN_ROLE=super_admin

# Optional: individual staff can also sign in with Google. These Google emails become super admins on first sign-in.
ADMIN_EMAILS=

# HMAC secret for sessions, QR tokens and check-in tickets (32+ random chars, server-only).
# Generate one with: openssl rand -base64 48
QR_SIGNING_SECRET=replace-with-at-least-32-random-bytes

# ---------------------------------------------------------------------------
# EVERYTHING BELOW IS OPTIONAL. The app is fully usable for free without it:
#  - registration = name + phone (verified for free at first check-in / by Google / by an admin)
#  - broadcasts reach the member portal, and "Share on WhatsApp" posts the flyer to your
#    WhatsApp broadcast lists / groups / Status / Channel at no cost.
# ---------------------------------------------------------------------------

# Require an SMS code at registration (costs one SMS per sign-up; needs Termii below). Default: off.
REGISTRATION_OTP=false

# SMS (Termii) — only for REGISTRATION_OTP and automatic SMS broadcasts / WhatsApp fallback.
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=
TERMII_CHANNEL=generic

# Automatic WhatsApp (Meta WhatsApp Business Cloud API) — sends every broadcast to each member's WhatsApp
# without anyone tapping "share". Meta charges per template message after the free test phase.
# Setup: https://developers.facebook.com/apps → Create app → Business → add "WhatsApp" (see README §4).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved text template, body: "*{{1}}*  {{2}}"   ({{1}} = title, {{2}} = message)
WHATSAPP_TEMPLATE_NAME=
# Approved template with an IMAGE header (the flyer) + the same body — used when a broadcast has a flyer.
WHATSAPP_FLYER_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# Webhook: callback URL <APP_URL>/api/webhooks/whatsapp, subscribe to "messages".
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Email (Resend) — optional. Free tier is enough for V1. Verify flagupjesus.org in Resend first, then e.g.
# EMAIL_FROM=FlagUpJesus <news@flagupjesus.org>   (replies go to the contact email in Admin → Settings)

RESEND_API_KEY=
EMAIL_FROM=

# Developer sign-in without Google (unverified!). Auto-on only for local dev with the local JSON store.
# ALLOW_DEV_LOGIN=false

# Automatic absence follow-up runs daily via Vercel Cron (vercel.json → /api/cron/follow-ups).
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>"; any long random text, e.g. `openssl rand -hex 24`.
CRON_SECRET=
