CLIENT_ID=
CLIENT_SECRET=

# Optional: only for server-side operations that bypass row-level security.
# Keep this server-only; it is not required for normal Auth/RLS-backed app usage.
>>>>>>> Stashed changes
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in (OAuth client from Google Cloud Console → APIs & Services → Credentials).
# Authorised redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
CLIENT_ID=
CLIENT_SECRET=

# First staff account(s): Google emails that become super admins on first sign-in (comma-separated).
ADMIN_EMAILS=

# HMAC secret for sessions, QR tokens and check-in tickets (32+ random chars, server-only).
# Generate one with: openssl rand -base64 48
QR_SIGNING_SECRET=replace-with-at-least-32-random-bytes

# Optional outbound messaging for broadcasts (in-app delivery always works).
TERMII_API_KEY=
TERMII_SENDER_ID=
RESEND_API_KEY=
EMAIL_FROM=

# Developer sign-in without Google (unverified!). Auto-on only for local dev with the local JSON store.
# ALLOW_DEV_LOGIN=false
