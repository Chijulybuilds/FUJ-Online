# Copy this file to .env.local.
# The application runs in DEMO mode when Supabase values are empty.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FlagUpJesus
NEXT_PUBLIC_CHURCH_NAME=Flag of Jesus Global Ministry
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: only for server-side operations that bypass row-level security.
# Keep this server-only; it is not required for normal Auth/RLS-backed app usage.
SUPABASE_SERVICE_ROLE_KEY=
# Required for live QR signing; keep server-only.
QR_SIGNING_SECRET=replace-with-at-least-32-random-bytes
